{
  "name": "canton-home-build",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vercel-build.mjs",
    "preview": "vite preview",
    "verify:pmt-sync": "node scripts/verify-pmt-sync.mjs",
    "verify:cloud-sync": "node scripts/verify-cloud-sync.mjs",
    "verify:offline-incident": "node scripts/test-offline-incident.mjs",
    "verify:revision-boot": "node scripts/test-revision-boot.mjs",
    "db:staging:verify": "node scripts/db/verify-staging-connection.mjs",
    "db:staging:fetch-source": "node scripts/db/fetch-migration-source.mjs",
    "db:staging:schema": "node scripts/db/apply-staging-schema.mjs",
    "db:staging:migrate": "node scripts/db/run-staging-migration.mjs",
    "db:staging:reconcile": "node scripts/db/reconcile-staging.mjs",
    "db:staging:test": "node scripts/db/test-staging-migration.mjs",
    "db:staging:test:legacy-version": "node scripts/db/test-legacy-version.mjs",
    "db:staging:test:concurrency": "node scripts/db/test-staging-concurrency.mjs",
    "db:staging:pipeline": "node scripts/db/test-staging-migration.mjs && node scripts/db/apply-staging-schema.mjs --reset && node scripts/db/run-staging-migration.mjs --reset && node scripts/db/reconcile-staging.mjs && node scripts/db/test-staging-concurrency.mjs",
    "staging:api": "node scripts/staging-api-server.mjs",
    "dev:staging": "VITE_STAGING_DB_MODE=true vite",
    "build:staging": "VITE_STAGING_DB_MODE=true VITE_STAGING_API_BASE=/staging-api vite build",
    "staging:serve": "node scripts/staging-combined-server.mjs",
    "staging:tunnel": "cloudflared tunnel --url http://localhost:3335",
    "db:staging:storage:setup": "node scripts/db/setup-staging-storage.mjs",
    "db:staging:storage:test": "node scripts/db/test-staging-document-storage.mjs",
    "db:staging:date-format": "node scripts/db/test-staging-date-format.mjs",
    "db:staging:ui-tests": "node scripts/db/run-staging-ui-tests.mjs",
    "db:staging:test:persist:queue": "node scripts/db/test-db-persist-queue.mjs",
    "db:staging:test:persist": "node scripts/db/test-staging-db-persist.mjs",
    "setup:vercel:staging": "node scripts/setup-vercel-env.mjs --profile staging",
    "setup:vercel:production": "node scripts/setup-vercel-env.mjs --profile production",
    "setup:vercel:all": "node scripts/setup-vercel-env.mjs --profile all",
    "deploy:staging": "vercel deploy --local-config vercel.staging.json",
    "deploy:staging:preview": "node scripts/deploy-staging-preview.mjs",
    "db:production:verify": "node scripts/db/verify-production-connection.mjs",
    "db:production:test:safety": "node scripts/db/test-production-safety.mjs",
    "db:secrets:test": "node scripts/db/test-no-committed-secrets.mjs",
    "db:production:fetch-source": "node scripts/db/fetch-production-source.mjs",
    "db:production:record-baseline": "node scripts/db/record-production-baseline.mjs",
    "db:production:backup-storage": "node scripts/db/backup-production-storage.mjs",
    "db:production:schema": "node scripts/db/apply-production-schema.mjs",
    "db:production:migrate": "node scripts/db/run-production-migration.mjs",
    "db:production:reconcile": "node scripts/db/reconcile-production.mjs",
    "db:production:deploy-gate": "node scripts/db/production-deploy-gate.mjs",
    "db:production:test": "node scripts/db/test-production-safety.mjs && node scripts/db/test-staging-migration.mjs",
    "production:api": "node scripts/production-api-server.mjs",
    "dev:production": "VITE_PRODUCTION_DB_MODE=true vite",
    "build:production": "VITE_PRODUCTION_DB_MODE=true VITE_PRODUCTION_API_BASE=/production-api vite build",
    "build:vercel:production": "VERCEL_BUILD_PROFILE=production-db VITE_PRODUCTION_DB_MODE=true VITE_PRODUCTION_API_BASE=/api/production vite build",
    "build:vercel:staging": "VERCEL_BUILD_PROFILE=staging-db VITE_STAGING_DB_MODE=true VITE_STAGING_API_BASE=/api/staging vite build",
    "deploy:production:preview": "node scripts/deploy-production-preview.mjs",
    "deploy:production:db": "node scripts/deploy-production-prod.mjs",
    "db:production:preview-tests": "node scripts/db/run-production-preview-tests.mjs",
    "db:production:test:routing": "node scripts/db/test-vercel-api-routing.mjs",
    "db:production:test:storage-fetch": "node scripts/db/test-storage-fetch-path.mjs",
    "rollback:production": "node scripts/rollback-production-deploy.mjs --yes"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "classic-level": "^3.0.0",
    "jsonrepair": "^3.15.0",
    "pg": "^8.23.1",
    "supabase": "^2.119.0",
    "vite": "^6.0.1"
  }
}
